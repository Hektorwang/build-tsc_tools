#!/usr/bin/env bash
# shellcheck disable=SC1090,SC1091
set -o errexit
set -o nounset
set -o pipefail
set +o posix
shopt -s nullglob

WORK_DIR="$(dirname "$(readlink -f "$0")")"
source "${WORK_DIR}/func"

# if ! ${TSC_FUNC:-false}; then
#     source "${WORK_DIR}/func"
# fi

declare -gA registered_modules_map=()
declare -gA module_arg_indices=()
declare -ga module_order=()
declare -g all_args=()

# 在 TSC_MODULES_DIR 的多个目录里查找某个 module 的实际目录
# TSC_MODULES_DIR 由 source /home/tsc/tsc_profile 后注入, 冒号分隔多目录
# 参数: $1 module 名
# 输出: 找到的目录绝对路径
# 返回: 0 找到, 1 未找到或 TSC_MODULES_DIR 未设
function _find_module_dir() {
    local module_name="$1" _dir _path
    [[ -n "${TSC_MODULES_DIR:-}" ]] || return 1
    local IFS=':'
    for _dir in ${TSC_MODULES_DIR}; do
        _path="${_dir%/}/${module_name}"
        if [[ -d "${_path}" ]]; then
            printf '%s' "${_path}"
            return 0
        fi
    done
    return 1
}

function load_registered_modules() {
    if [[ -z "${TSC_MODULES_DIR:-}" ]]; then
        LOGERROR "TSC_MODULES_DIR 未设置, 请先 source /home/tsc/tsc_profile"
        return 1
    fi
    local _dir _entry _module
    local IFS=':'
    for _dir in ${TSC_MODULES_DIR}; do
        [[ -d "${_dir}" ]] || continue
        for _entry in "${_dir}"/*/; do
            if [[ -f "${_entry}run.sh" ]] || [[ -f "${_entry}run" ]]; then
                _module="$(basename "${_entry}")"
                registered_modules_map["${_module}"]=1
            fi
        done
    done
}

function is_valid_module() {
    local name="$1"
    [[ -n "${registered_modules_map[$name]:-}" ]] ||
        return 1
}

function parse_arguments_by_module() {
    local args=("$@")
    local i=0
    local current_module=""
    # a_start: 当前模块的参数在 all_args 中的起始下标
    # (模块名 token 不进 all_args, 边界必须用 all_args 长度衡量, 否则切片错位)
    local a_start=0

    while ((i < ${#args[@]})); do
        local arg="${args[i]}"
        if [[ "$arg" == --* ]]; then
            local candidate="${arg#--}"
            if is_valid_module "${candidate}"; then
                if [[ -n "${current_module}" ]]; then
                    module_arg_indices["${current_module}"]="${a_start}"
                    module_arg_indices["${current_module}_end"]="${#all_args[@]}"
                fi
                current_module="${candidate}"
                module_order+=("${candidate}")
                a_start="${#all_args[@]}"
                i=$((i + 1))
                continue
            fi
        fi
        all_args+=("${arg}")
        i=$((i + 1))
    done

    if [[ -n "$current_module" ]]; then
        module_arg_indices["$current_module"]="${a_start}"
        module_arg_indices["${current_module}_end"]="${#all_args[@]}"
    fi
    if [[ ${#module_arg_indices[@]} -eq 0 && ${#all_args[@]} -gt 0 ]]; then
        LOGERROR "Some arguments do not belong to any module."
        show_global_help
        exit 1
    fi
}

function run_module_with_args() {
    local module_name="$1"
    shift
    local args=("$@")
    local module_dir
    module_dir="$(_find_module_dir "${module_name}")" || {
        LOGERROR "Module dir not found: ${module_name}"
        exit 1
    }
    # 与 load_registered_modules 的判定保持一致: run.sh 优先, 其次 run
    local script_path="" candidate
    for candidate in run.sh run; do
        if [[ -x "${module_dir}/${candidate}" ]]; then
            script_path="${module_dir}/${candidate}"
            break
        fi
    done
    if [[ -n "${script_path}" ]]; then
        # LOGINFO "Running module: ${module_name}"
        "${script_path}" "${args[@]}"
    else
        LOGERROR "Module script not found or not executable in: ${module_dir}"
        exit 1
    fi
}

function read_module_metadata() {
    local module_name="$1"
    local module_dir
    module_dir="$(_find_module_dir "${module_name}")" || return 1
    local meta_file="${module_dir}/README.md"

    if [[ -f "${meta_file}" ]]; then
        awk 'BEGIN{c=0} /^---$/{c++; if(c==1){next}; if(c==2){exit}} c==1' "${meta_file}" 
    else
        return 1
    fi
}

function show_global_help() {
    echo "Usage:"
    echo " $(basename "$0") [--module] <module_args> <--module> <--module> <module_args>"
    echo ""
    echo "Available modules:"
    local meta description usage module

    # 关联数组遍历顺序不确定, 排序后输出保证帮助列表稳定
    # 各 $(...) 加 || true: 缺少 README.md / 缺 description 时命令替换非零,
    # 在 set -e 下会直接终止整个帮助输出
    while IFS= read -r module; do
        meta=$(read_module_metadata "${module}" 2>/dev/null || true)
        description=$(echo "${meta}" | grep -oP  '(?<=^description: ).*$' || true)
        usage=$(echo "${meta}" | grep -oP  '(?<=^usage: ).*$' || true)
        echo "  --${module}"
        echo "      ${description}"
        if [[ -n "${usage}" ]]; then
            echo "      ${usage}"
        fi
    done < <(printf '%s\n' "${!registered_modules_map[@]}" | sort)
    return 0
}

function main() {
    load_registered_modules
    # 帮助优先于模块解析: 否则 -h/help 会被当作"不属于任何模块"而报错退出
    if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" || "$1" == "help" ]]; then
        show_global_help
        exit 0
    fi

    parse_arguments_by_module "$@"

    # 按命令行出现顺序执行模块(关联数组遍历无序, 用 module_order 保持顺序)
    local module
    for module in "${module_order[@]}"; do
        local start=${module_arg_indices[$module]}
        local end=${module_arg_indices["${module}_end"]}
        local count=$((end - start))
        set +o nounset
        local module_args=("${all_args[@]:$start:$count}")
        run_module_with_args "$module" "${module_args[@]}"
    done
}

main "$@"
